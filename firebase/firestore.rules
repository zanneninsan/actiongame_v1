rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboardScores/{scoreId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /leaderboardGhosts/{ghostId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /stageProposals/{proposalId} {
      allow read, create, update, delete: if false;
    }

    match /users/{userId}/settings/{settingsId} {
      allow read, write: if request.auth != null && request.auth.uid == userId && settingsId == "app";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
